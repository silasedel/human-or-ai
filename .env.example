# ---------------------------------------------------------------------------
# Human? — environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Local:   postgresql://USER:PASSWORD@localhost:5432/humanorai
# Neon:    postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: use the "Session pooler" / direct connection string from the dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/humanorai"

# Long random string used to sign cookies (admin session). Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Password for the /admin area (required to use admin features).
ADMIN_PASSWORD="change-me"

# ---------------------------------------------------------------------------
# AI post generation (optional — the seed data works without any of this)
# ---------------------------------------------------------------------------
# Which provider to use: "anthropic" (default) or "openai-compatible"
AI_PROVIDER="anthropic"

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# Model to use for generation. Defaults to claude-opus-5.
AI_MODEL="claude-opus-5"

# Any OpenAI-compatible chat completions endpoint (OpenAI, Groq, Ollama, ...)
# Only used when AI_PROVIDER="openai-compatible".
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Secret that protects the scheduled generation endpoint (/api/cron/generate).
# Vercel sets the Authorization header automatically for cron jobs when this is set.
CRON_SECRET=""
# How many posts the cron endpoint should generate per run (spread over the next 24h).
AI_CRON_POST_COUNT="24"

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Minimum guesses before a player shows up on the leaderboard.
LEADERBOARD_MIN_GUESSES="20"
